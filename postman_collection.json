{
  "info": {
    "_postman_id": "97d76c1b-5f7e-4c79-ae24-1d54d4ff0ec8",
    "name": "Antivirus Server API",
    "description": "Postman collection for the antivirus server modules implemented inside this project.\n\nManual prerequisite for ADMIN checks:\n1. Run \"Register Admin Candidate\".\n2. Grant ADMIN role in PostgreSQL.\n3. Run \"Login Admin\" again to receive an ADMIN JWT.\n\nSuggested SQL:\ninsert into auth_user_roles(user_id, role_id)\nselect u.id, r.id\nfrom auth_users u\njoin auth_roles r on r.name = 'ADMIN'\nwhere u.username = 'antivirus-admin'\non conflict do nothing;",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"baseUrl\")) {",
          "    pm.collectionVariables.set(\"baseUrl\", \"http://localhost:8080\");",
          "}",
          "if (!pm.collectionVariables.get(\"since\")) {",
          "    pm.collectionVariables.set(\"since\", new Date().toISOString());",
          "}"
        ]
      }
    }
  ],
